[Unit]
Description=Home Display kiosk browser
After=systemd-user-sessions.service network-online.target home-display-agent.service
Wants=network-online.target
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
User=hdkiosk
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=WLR_LIBINPUT_NO_DEVICES=1
ExecStart=/usr/bin/cage -s -- /usr/local/lib/home-display/kiosk-session.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
