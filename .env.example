# Copy to .env (the Pi installer does this for you and fills in the secrets).

# Signs login sessions and encrypts stored Google tokens. Keep it secret and never change it
# once you have connected Google, or the saved tokens become unreadable.
APP_SECRET=

# Shared secret between the app and the device agent on the Pi.
HOST_AGENT_TOKEN=
HOST_AGENT_URL=http://127.0.0.1:8765

# Your time zone, e.g. America/Chicago. Calendar days and "today" follow it.
TZ=UTC

# Google (Calendar + Sheets). See docs/google-setup.md. Leave empty to use calendar links only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Leave empty for the paste-the-link flow. Set to https://<your host>/api/google/callback if you
# use a "Web application" OAuth client with a public HTTPS address.
GOOGLE_REDIRECT_URI=

# Set to true if you serve the admin app over HTTPS.
SECURE_COOKIES=false
LOG_LEVEL=info
