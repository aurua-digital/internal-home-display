{
  "name": "home-display",
  "private": true,
  "version": "0.1.0",
  "description": "Self-hosted, DAKboard-style home display for a Raspberry Pi on a TV",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build -w @hd/web && npm run build -w @hd/api",
    "start": "node apps/api/dist/server.js",
    "typecheck": "tsc -p apps/api && tsc -p apps/web",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "~5.9.0",
    "vitest": "^3.2.0"
  }
}
